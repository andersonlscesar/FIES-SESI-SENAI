# Copie para .env e preencha. NUNCA versione o .env.

# Nome do projeto Docker (prefixo de containers, rede e volume). Mantenha "stbp" em produção.
STBP_PROJETO=stbp

# Porta HTTP publicada no servidor
STBP_PORTA=80

# Banco de dados (o usuário e a senha são criados na primeira subida do Postgres)
STBP_DB_NOME=stbp
STBP_DB_USUARIO=stbp
# Gere com: openssl rand -base64 24
STBP_DB_SENHA=

# Segredo que assina os tokens de login (mínimo 32 caracteres). Trocá-lo desconecta todos os usuários.
# Gere com: openssl rand -base64 48
STBP_JWT_SEGREDO=

# Tag das imagens geradas (ex.: data da implantação)
STBP_VERSAO=latest
